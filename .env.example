# Copie para .env (em desenvolvimento). Em produção, cadastre no provedor.
PORT=3333
# Origens do front que podem chamar a API, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
UPSTREAM_BASE_URL=https://www.pornhub.com/webmasters
UPSTREAM_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=600

# --- Autenticação (ADR-0011) ---
# Arquivo do SQLite. No Render o disco é efêmero: o banco se perde a cada deploy
# e as contas de SEED_USERS são recriadas no boot.
DATABASE_FILE=data/wiseup.db
# Secret do reCAPTCHA v2 (https://www.google.com/recaptcha/admin). Nunca vai
# para o front. Vazio: em desenvolvimento o captcha passa com um aviso no
# console; em produção, todo login é recusado.
RECAPTCHA_SECRET=
# Validade da sessão, em horas
SESSION_TTL_HOURS=12
# Erros de senha até bloquear a conta, e por quantos minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Contas criadas no boot, no formato email:senha,email:senha (a senha pode ter ':')
SEED_USERS=ana@wiseup.test:segredo123
