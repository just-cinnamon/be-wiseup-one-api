# Copie para .env (em desenvolvimento). Em produção, cadastre no provedor.
PORT=3333
# Origens do front que podem chamar a API, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
UPSTREAM_BASE_URL=https://www.pornhub.com/webmasters
UPSTREAM_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=600

# --- Banco e autenticação (ADR-0011, ADR-0013, ADR-0014) ---
# Postgres gerenciado (ADR-0013). Neon, Supabase ou o Postgres do Render — o
# plano gratuito de qualquer um serve. O SQLite saiu porque o disco do Render é
# efêmero, e denúncia, bloqueio de vídeo e aceite de termos precisam sobreviver
# a um deploy.
#   DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Postgres local (sem TLS) também funciona:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wiseup
DATABASE_URL=
# Só para provedor com certificado próprio: deixa de validar o certificado do
# servidor. Mantenha vazio ou false salvo necessidade comprovada.
DATABASE_SSL_INSECURE=false
# Secret do reCAPTCHA v2 (https://www.google.com/recaptcha/admin). Nunca vai
# para o front. VAZIO = o login NÃO pede captcha (ADR-0014), e a defesa contra
# força bruta passa a ser só o bloqueio por conta abaixo. Cadastrar o secret
# liga a exigência do token e a verificação no siteverify, sem mexer no código.
RECAPTCHA_SECRET=
# Validade da sessão, em horas
SESSION_TTL_HOURS=12
# Erros de senha até bloquear a conta, e por quantos minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Contas criadas no boot, no formato email:senha,email:senha (a senha pode ter ':')
SEED_USERS=ana@wiseup.test:segredo123

# --- Verificação de idade (ADR-0015) ---
# Provedor que atenda ao Decreto 12.880/2026. Sem as duas variáveis, a
# verificação recusa TUDO e o catálogo fica inacessível — é o lado certo para
# errar. O adaptador está em src/services/ageService.js: trocar de provedor
# mexe só nele.
AGE_PROVIDER_URL=
AGE_PROVIDER_KEY=
# Segredo com que o provedor assina o webhook (HMAC-SHA256 do corpo cru). Sem
# ele, nenhuma assinatura é aceita e nenhuma conta é marcada como verificada.
AGE_WEBHOOK_SECRET=
# ATALHO DE DESENVOLVIMENTO: marca qualquer conta como verificada, sem provedor
# nenhum. Serve para rodar o front sem contrato assinado. É IGNORADO quando
# NODE_ENV=production — e jamais deve ser cadastrado no provedor de produção.
AGE_DEV_AUTOVERIFY=false
